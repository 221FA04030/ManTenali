# Mana Tenali client - copy to client/.env.local if you need to override defaults.
# Only VITE_* variables reach the browser and NONE of them may be secrets.

# API base URL. In development the default '/api/v1' is proxied to http://localhost:4000.
VITE_API_URL=/api/v1

# Public Google OAuth client id (Step 1) - not a secret
VITE_GOOGLE_CLIENT_ID=

# Public Cloudinary cloud name (Step 2) - not a secret
VITE_CLOUDINARY_CLOUD_NAME=

# Optional error reporting
VITE_SENTRY_DSN=
