# Mana Tenali API - copy to server/.env (git-ignored) and fill in real values.
# Never commit server/.env. Never paste secrets into chat, code or logs.

NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug

# MongoDB Atlas connection string - supplied by the project owner, kept only in server/.env
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/mana_tenali?retryWrites=true&w=majority

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind one reverse proxy (Render/Railway) so rate limits see real client IPs
TRUST_PROXY=0

# --- Step 1: authentication ---
# Long random secret for signing session tokens (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=<generate-a-long-random-secret-at-least-32-chars>
JWT_EXPIRES_IN=7d
# Parent domain shared by app and API in production (e.g. .example.in); leave empty for localhost
COOKIE_DOMAIN=
# Google OAuth client id (public) - Google sign-in is disabled until set
GOOGLE_CLIENT_ID=

# Local-only initial admin bootstrap: `npm run seed:admin` (remove the password afterwards)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=Mana Tenali Admin

# --- Step 2: image uploads (provider: Cloudinary) ---
# All three are required for photo uploads. If any is missing, POST /api/v1/media/sign
# returns 503 SERVICE_UNAVAILABLE and the server logs which names are missing at startup.
# Where to find them: Cloudinary Console -> Settings -> API Keys (cloud name is shown at the top).
# Paste the raw values with no quotes or spaces, then RESTART the server. Verify with: npm run check:media
# The API secret stays on the server; browsers only ever receive a one-time signature.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# --- Step 10: production and monitoring ---
# In production: NODE_ENV=production, TRUST_PROXY=1 (Render), CLIENT_ORIGIN must be https://, and
# COOKIE_DOMAIN must be the shared parent domain (e.g. .manatenali.in). The server refuses to start otherwise.
# Optional error reporting (Sentry). Off when empty. Only unexpected errors are sent, without personal data.
SENTRY_DSN=
