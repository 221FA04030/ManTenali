{
  "name": "mana-tenali",
  "private": true,
  "version": "0.1.0",
  "description": "Mana Tenali - local discovery and community app for Tenali (Phase 1)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "test": "npm test -w server && npm test -w client",
    "build": "npm run build -w client",
    "format": "prettier --write \"server/src/**/*.js\" \"client/src/**/*.{js,jsx,css,json}\"",
    "seed": "npm run seed -w server --",
    "seed:admin": "npm run seed:admin -w server --",
    "check:media": "npm run check:media -w server --",
    "migrate:categories": "npm run migrate:categories -w server --",
    "cleanup:evidence": "npm run cleanup:evidence -w server --",
    "demo": "node server/src/scripts/demo.js",
    "check:launch": "npm run check:launch -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22.9"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
